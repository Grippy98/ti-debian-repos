From: Andrei Aldea <andrei@ti.com>
Date: Mon, 17 Aug 2026 11:20:35 -0500
Subject: Support pre-PEP-639 Setuptools releases

Bookworm and Jammy validate project.license using the older PEP 621 table
schema and do not recognize project.license-files. The table form remains
accepted by current Setuptools, so use it for all supported suites.
---
 pyproject.toml | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -4,8 +4,7 @@ dynamic = ["version"]  # Load from ml
 description = "ml_dtypes is a stand-alone implementation of several NumPy dtype extensions used in machine learning."
 readme = "README.md"
 requires-python = ">=3.9"
-license = "Apache-2.0"
-license-files = ["LICENSE", "LICENSE.eigen"]
+license = {text = "Apache-2.0"}
 authors = [{name = "ml_dtypes authors", email="ml_dtypes@google.com"}]
 classifiers = [
     "Programming Language :: Python :: 3",
