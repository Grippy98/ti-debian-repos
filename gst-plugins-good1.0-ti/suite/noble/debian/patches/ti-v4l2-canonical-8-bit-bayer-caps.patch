Description: v4l2: use canonical caps names for 8-bit Bayer formats
 GStreamer 1.24 advertises three 8-bit V4L2 Bayer formats with a spurious
 native-endian suffix (gbrgle, grbgle, rggble), while its reverse caps-to-
 fourcc path and the video/x-bayer media type accept gbrg, grbg, and rggb.
 This makes the advertised formats impossible to set. Use the canonical
 endian-independent names, consistent with BGGR8 and newer GStreamer releases.
Author: Andrei Aldea <andrei@ti.com>
Forwarded: not-needed
Last-Update: 2026-08-17

--- a/sys/v4l2/gstv4l2object.c
+++ b/sys/v4l2/gstv4l2object.c
@@ -1661,7 +1661,7 @@ gst_v4l2_object_v4l2fourcc_to_bare_stru
       bayer_format = "bggr16le";
       break;
     case V4L2_PIX_FMT_SGBRG8:
-      bayer_format = "gbrgle";
+      bayer_format = "gbrg";
       break;
     case V4L2_PIX_FMT_SGBRG10:
       bayer_format = "gbrg10le";
@@ -1676,7 +1676,7 @@ gst_v4l2_object_v4l2fourcc_to_bare_stru
       bayer_format = "gbrg16le";
       break;
     case V4L2_PIX_FMT_SGRBG8:
-      bayer_format = "grbgle";
+      bayer_format = "grbg";
       break;
     case V4L2_PIX_FMT_SGRBG10:
       bayer_format = "grbg10le";
@@ -1691,7 +1691,7 @@ gst_v4l2_object_v4l2fourcc_to_bare_stru
       bayer_format = "grbg16le";
       break;
     case V4L2_PIX_FMT_SRGGB8:
-      bayer_format = "rggble";
+      bayer_format = "rggb";
       break;
     case V4L2_PIX_FMT_SRGGB10:
       bayer_format = "rggb10le";
